{
  "name": "satori-patterns",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "description": "Satori-compatible background patterns for use with @vercel/og and ImageResponse. Translated and verified from PatternCraft.",
  "keywords": [
    "satori",
    "og-image",
    "patterns",
    "background",
    "open-graph",
    "next.js",
    "vercel",
    "social-media",
    "patterncraft"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Babatunde-Fatai/satori-patterns.git"
  },
  "homepage": "https://github.com/Babatunde-Fatai/satori-patterns#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "peerDependencies": {
    "satori": ">=0.10.0"
  },
  "scripts": {
    "build:index": "tsx ../../scripts/build-index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
